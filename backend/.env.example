# ForgeIQ Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME=FORGEIQ
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# -------------------------------------------------------
# CORS
# Set to comma-separated list of allowed origins in production.
# Example: CORS_ORIGINS=https://forgeiq.yourdomain.com
# Leave as * for local development only.
# -------------------------------------------------------
CORS_ORIGINS=*

# -------------------------------------------------------
# Groq LLM (optional — Copilot falls back to deterministic engine if not set)
# Get your free key at: https://console.groq.com
# -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
